# ─── hh.ru ────────────────────────────────────────────────────────────
#HH_COOKIE=
#HH_ACCESS_TOKEN=
#HH_USER_AGENT=
#HH_XSRF_TOKEN=

# ─── Фильтры ──────────────────────────────────────────────────────────
HH_AREA=113
HH_PROFESSIONAL_ROLE=124
HH_EMPLOYMENT_FORM=FULL
HH_WORK_FORMAT=REMOTE
HH_EXPERIENCE=between1And3,between3And6
HH_LABEL=accept_labor_contract
HH_PERIOD_DAYS=1
HH_ORDER_BY=publication_time
HH_PER_PAGE=100

# ─── ВКонтакте ────────────────────────────────────────────────────────
# Токен сообщества (Настройки → Работа с API → Ключи доступа, право "сообщения")
VK_TOKEN=
# peer_id: для личного диалога = user_id; для беседы = 2000000000 + chat_id
VK_PEER_ID=
VK_API_VERSION=5.199

# ─── Режим ────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
STATE_DB=state.db
SEED_ON_FIRST_RUN=true
FRESH_HOURS=6
LOG_FILE=monitor.log